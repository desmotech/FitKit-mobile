# FitKit Mobile — local dev env. Copy to .env (or .env.local).
# Variables prefixed EXPO_PUBLIC_ are inlined into the client bundle.

# Backend
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WS_URL=http://localhost:3001

# Clerk
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Sentry — public DSN; safe to commit. Auth token (SENTRY_AUTH_TOKEN)
# lives in .env.local for local builds + EAS secret in CI.
EXPO_PUBLIC_SENTRY_DSN=https://4a3e004c0fa2a2f8964d9f431e3efd3e@o4510894662090752.ingest.de.sentry.io/4511416743362640

# PostHog — public project key; safe to commit. Shares the web project so
# funnels stitch web → mobile (distinct_id = Clerk user id on both).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# EAS — set in eas.json or CI secrets, not committed
# EAS_PROJECT_ID=
# EAS_UPDATES_URL=
